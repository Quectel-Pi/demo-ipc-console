# Copy this file to .env and fill in your own camera settings.
CAMERA_IP=192.0.2.10
CAMERA_USER=admin
CAMERA_PASSWORD=

# ONVIF and RTSP addresses vary by manufacturer and model.
ONVIF_USER=admin
ONVIF_PASSWORD=
ONVIF_PORT=80
ONVIF_URL=http://192.0.2.10:80/onvif/device_service
RTSP_URL=rtsp://192.0.2.10:554/Streaming/Channels/101
